---
import type { SvgComponent } from 'astro/types';
import styles from './ProjectCard.module.css';

interface Tag {
	label: string;
	url: string;
}

interface Props {
	href: string;
	icon: SvgComponent;
	domain: string;
	badge?: string;
	title: string;
	tags: Tag[];
	date: string;
}

const { href, icon: Icon, domain, badge, title, tags, date } = Astro.props;
---

<article class={styles.card}>
	{badge && <span class={styles.badge}>{badge}</span>}
	<div class={styles.top}>
		<Icon width={18} height={18} class={styles.icon} aria-hidden="true" />
		<span class={styles.domain}>{domain}</span>
	</div>
	<div class={styles.divider}></div>
	<div class={styles.body}>
		<h3 class={styles.title}>
			<a href={href} class={styles.link} target="_blank" rel="noopener">{title}</a>
		</h3>
		<p class={styles.description}><slot /></p>
	</div>
	<div class={styles.footer}>
		<span class={styles.tags}>
			{
				tags.map((tag) => (
					<a href={tag.url} class={styles.tag} target="_blank" rel="noopener">
						{tag.label}
					</a>
				))
			}
		</span>
		<span class={styles.date}>{date}</span>
	</div>
</article>
