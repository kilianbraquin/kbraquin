---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';

interface Props {
  className?: string;
  description?: string;
  hideFooter?: boolean;
  title?: string;
}

const { className, description, hideFooter, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-main-bg md:bg-side-bg">
    <div
      class="layout-container bg-main-bg md:border-x-container-border flex min-h-screen flex-col border-x pt-4 pb-3"
    >
      <main class={className}>
        <slot />
      </main>
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>
